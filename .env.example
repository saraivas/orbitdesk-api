TEST_REDIS_URL=redis://localhost:6380/15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_MAX_LIFETIME_DAYS=30
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
